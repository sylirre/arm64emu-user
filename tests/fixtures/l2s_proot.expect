mtime x2: 1000000000
fchownat x2 NOFOLLOW: 0 errno=0
faccessat x2 NOFOLLOW: 0 errno=0
== exec
exec-child ok
execve bin2/t2: exit 0
exec-child ok
execveat NOFOLLOW bin2/t2: exit 0
== the ends
link x2 g/z: 0 errno=0
lstat g/z: reg nlink=2 size=6 mode=644
lstat x2: reg nlink=2 size=6 mode=644
same g/z x2: 1
unlink g/x1new (the last name of its group): 0 errno=0
lstat g/z: reg nlink=2 size=6 mode=644
done
